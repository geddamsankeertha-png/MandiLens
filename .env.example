# ==============================================================================
# KisanMandi – Zero-Cost Offline-First Configuration (.env.example)
# ==============================================================================
# NO PAID API KEYS OR CLOUD CREDENTIALS ARE REQUIRED TO RUN THIS PROJECT.
# Leave optional external keys blank for 100% offline local demonstration.

# Server Port (AI Studio & local dev standard: 3000)
PORT=3000

# Local SQLite Database Path (defaults to ./data/kisanmandi.db)
SQLITE_DB_PATH="./data/kisanmandi.db"

# JWT Signing Secret (set a strong random string in deployment; dev ephemeral fallback auto-generated if empty)
JWT_SECRET=""

# Optional Custom Passwords for Local Seeded Demo Accounts (random/default offline dev credentials if unset)
DEMO_USER_PASSWORD=""
ADMIN_BOOTSTRAP_PASSWORD=""

# ==============================================================================
# OPTIONAL EXTERNAL INTEGRATIONS (NOT REQUIRED)
# ==============================================================================

# GEMINI_API_KEY (Optional): Enables AI market estimate overlay in Price Explorer.
# When empty, all spot benchmarks and forecasts run deterministically from SQLite + Python ML.
GEMINI_API_KEY=""

# DATA_GOV_IN_API_KEY (Optional): Enables live AGMARKNET sync from data.gov.in resource 9ef84268-d588-465a-a308-a864a43d0070.
# When empty, the bundled sample CSV + SQLite database serves all pages offline.
DATA_GOV_IN_API_KEY=""

# VITE_ENABLE_FIREBASE (Optional, defaults to false): Keep false for zero-cost SQLite auth/storage.
VITE_ENABLE_FIREBASE="false"

# Optional SMTP Email Verification (Gmail SMTP or standard SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KisanMandi Support <noreply@kisanmandi.local>"
APP_BASE_URL="http://localhost:3000"

